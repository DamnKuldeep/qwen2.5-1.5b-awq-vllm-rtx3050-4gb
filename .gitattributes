# Normalise line endings so a clone behaves the same on Windows and Linux.
#
# This matters here specifically: the gateway Dockerfile writes its CMD as an
# inline `sh -c` rather than a .sh file BECAUSE a shell script authored on
# Windows once carried CRLF endings into a Linux container and failed with an
# opaque "no such file or directory" pointing at the interpreter. Pinning .sh
# to LF and .ps1 to CRLF removes that class of failure for anyone cloning.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.html text eol=lf
*.ini  text eol=lf
*.txt  text eol=lf
Dockerfile text eol=lf

*.ps1  text eol=crlf

*.db   binary
