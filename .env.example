# Gateway configuration. Copy to .env and edit, or set these in the
# environment directly - docker-compose.yml already passes each one through
# with the same default shown here.
#
#   cp .env.example .env
#
# THERE ARE NO SECRETS IN THIS FILE, and that is deliberate. API keys live in
# the SQLite ledger (gateway/seed_db.py seeds the demo ones), not in config,
# so there is nothing here that would be dangerous to commit. .env is
# gitignored anyway, because that stops being true the moment someone adds a
# real provider credential.
#
# Every default below is a measurement, not a preference. The derivations are
# in docs/CAPACITY_MODEL.md; the one-line versions are here.

# ---------------------------------------------------------------------------
# Upstream and storage
# ---------------------------------------------------------------------------

# The engine. Inside Docker Compose this is the service name, NOT localhost -
# inside the gateway container, localhost is the gateway.
VLLM_BASE_URL=http://vllm:8000

# The usage ledger: API keys, budgets, request history. A volume in Compose so
# budgets survive a container rebuild.
GATEWAY_DB_PATH=/data/usage.db

# ---------------------------------------------------------------------------
# Admission control - the gateway is the only limiter
# ---------------------------------------------------------------------------

# Requests allowed onto the GPU at once. THE measured number: p95 TTFT holds
# under 1.5 s at 6 with +24..33% margin, and fails by 36% at 12.
GATEWAY_MAX_INFLIGHT=6

# Requests allowed to WAIT for a slot. Shallow on purpose: the service
# completes ~1.4 req/s at the limit, so each queue slot adds ~0.7 s to
# someone's TTFT. This absorbs arrival jitter; it is not a backlog store.
GATEWAY_MAX_QUEUE=12

# The term that BOUNDS p95 TTFT under overload, since worst-case client TTFT is
# roughly this plus the engine's own TTFT. At 2.0 s the curve was flat but sat
# at 2,070 ms with 49/58 users breaching the SLO; at 0.6 s it sits at 778 ms
# with zero breaches, for ten points more shedding.
GATEWAY_QUEUE_TIMEOUT_S=0.6

# Upper bound on one key's share of the pool. The effective limit is dynamic -
# ceil(MAX_INFLIGHT / contending keys) - so an abusive client's share falls as
# other tenants arrive. A FIXED cap here was measured putting 10/10 normal
# users over the SLO, because 3-of-6 is half the service regardless of how
# many tenants exist.
GATEWAY_MAX_INFLIGHT_PER_KEY=3

# A stream outliving this is abandoned and its slot released, so a client
# reading one byte per second cannot hold capacity indefinitely.
GATEWAY_STREAM_TIMEOUT_S=300

# Advertised in Retry-After on a shed request.
GATEWAY_RETRY_AFTER_S=2

# Prompt length above which a request costs more than one admission slot, and
# the ceiling on that cost. 2048 is the engine's prefill chunk size
# (--max-num-batched-tokens), so cost is measured in "scheduler steps of
# prefill this will monopolise". The cap stays below MAX_INFLIGHT so no single
# request can take the whole pool.
GATEWAY_LONG_PROMPT_TOKENS=2048
GATEWAY_MAX_REQUEST_COST=4

# ---------------------------------------------------------------------------
# Output bounding - protects the admission limit
# ---------------------------------------------------------------------------

# vLLM defaults an ABSENT max_tokens to the rest of the context window - about
# 30,000 tokens on a 32k window - so a client that forgets the field can hold a
# slot for minutes. The gateway injects the default when it is missing and
# clamps anything above the ceiling, reporting it in X-Max-Tokens-Clamped-From.
GATEWAY_DEFAULT_MAX_TOKENS=1024
GATEWAY_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Billing integrity
# ---------------------------------------------------------------------------

# Consecutive ledger-write failures before the gateway refuses new work. The
# budget CHECK is a read and keeps succeeding in WAL mode while writes fail, so
# a run of failed WRITES is the only evidence of the outage. Some requests are
# necessarily served unbilled before this trips.
GATEWAY_BILLING_FAILURE_THRESHOLD=3

# How long the breaker stays open before letting one probe through. Without a
# half-open state it latches forever: it refuses every request at the auth
# check, so no write is ever attempted, so it can never reset.
GATEWAY_BILLING_RETRY_S=10

# Context window used only if /v1/models cannot be reached. The real value is
# discovered from the engine, because hardcoding what the server is serving is
# how the chat UI broke in Stage 11.
GATEWAY_MAX_MODEL_LEN=32768
